# Supabase project credentials.
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor (Dashboard > SQL)
# 3. Copy these from Project Settings > API
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional: Pexels API key for random cover images for steganography.
# Get one at https://www.pexels.com/api/
# If not set, the app falls back to Lorem Picsum (https://picsum.photos),
# then to bundled cover images.
VITE_PEXELS_API_KEY=""
